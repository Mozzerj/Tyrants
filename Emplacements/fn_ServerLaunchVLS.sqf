params ["_emplacementId",["_targetIndex",0]];
if (!isServer) exitWith {};
private _owner = remoteExecutedOwner;
private _player = [_owner] call TYR_fnc_FindPlayerByOwner;
if (isNull _player) exitWith {};
private _access = [_owner,_emplacementId,25] call TYR_fnc_VLSAccess;
if (count _access isEqualTo 0) exitWith {[_player,"TYR_fnc_ClientHint",["Move within 25m of your VLS."]] call TYR_fnc_ServerSendToPlayer};
private _fid = _access # 1;
private _obj = _access # 2;
private _f = [_fid] call TYR_fnc_StateGetFaction;
private _targets = _f getOrDefault ["vlsTargets",[]];
if (count _targets isEqualTo 0) exitWith {[_player,"TYR_fnc_ClientHint",["No VLS targets designated."]] call TYR_fnc_ServerSendToPlayer};
private _ammoCount = round (vehicleAmmo _obj * 18);
if (_ammoCount <= 0) exitWith {[_player,"TYR_fnc_ClientHint",["VLS is empty."]] call TYR_fnc_ServerSendToPlayer};
_targetIndex = (_targetIndex max 0) min ((count _targets)-1);
private _target = _targets # _targetIndex;
_obj setVehicleAmmo ((_ammoCount - 1) / 18);
["vls-launch"] call TYR_fnc_StateMarkDirty;
[_obj,_target,_fid] spawn TYR_fnc_CruiseMissileLaunch;
[_player,"TYR_fnc_ClientVLSState",[_emplacementId,+_targets,_ammoCount - 1]] call TYR_fnc_ServerSendToPlayer;
