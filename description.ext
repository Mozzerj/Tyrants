onLoadName = "Tyrants v4.0.13 DEV";
onLoadMission = "Three-faction strategic warfare // development baseline v4.0.13";
author = "Mozzerj";
enableDebugConsole = 1; // DEV: host/logged-in admins may also use Arma standard Debug Console.

import RscMapControl;
#include "Dialogs.hpp"

class Params
{
    class TYR_WestController
    {
        title = "WEST Strategic Controller";
        texts[] = {"Human","AI","Disabled"};
        values[] = {0,1,2};
        default = 0;
    };
    class TYR_EastController
    {
        title = "EAST Strategic Controller";
        texts[] = {"Human","AI","Disabled"};
        values[] = {0,1,2};
        default = 1;
    };
    class TYR_IndependentController
    {
        title = "INDEPENDENT Strategic Controller";
        texts[] = {"Human","AI","Disabled"};
        values[] = {0,1,2};
        default = 1;
    };
    class TYR_AIDifficulty
    {
        title = "AI Commander Difficulty";
        texts[] = {"Recruit","Regular","Veteran","Expert"};
        values[] = {0,1,2,3};
        default = 1;
    };
    class TYR_StartingResources
    {
        title = "Starting Steel / Ammo / Fuel";
        texts[] = {"5,000","10,000","15,000","30,000","50,000","100,000"};
        values[] = {5000,10000,15000,30000,50000,100000};
        default = 15000;
    };
    class TYR_StartingManpower
    {
        title = "Starting Manpower";
        texts[] = {"30","60","100","200"};
        values[] = {30,60,100,200};
        default = 60;
    };
    class TYR_ResetCampaign
    {
        title = "RESET SAVED CAMPAIGN ON START";
        texts[] = {"Keep Current Save","RESET - Start Fresh"};
        values[] = {0,1};
        default = 0;
    };
    class TYR_DebugMode
    {
        title = "Developer Debug Mode";
        texts[] = {"Disabled","Enabled"};
        values[] = {0,1};
        default = 0;
    };
};

respawn = 3;
respawnDelay = 30;
respawnDialog = 1;
reviveRequiredTrait = 0;
reviveRequiredItems = 2;
reviveRequiredItemsFakConsumed = 1;
reviveMedicSpeedMultiplier = 2;
reviveDelay = 10;
reviveForceRespawnDelay = 5;
reviveBleedOutDelay = 180;

class CfgFunctions
{
    #include "cfgFunctions.hpp"
};

