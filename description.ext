        class TYR_fnc_ServerLaunchVLS {allowedTargets=2;};
        class TYR_fnc_ServerRequestForce {allowedTargets=2;};
        class TYR_fnc_ServerDebugAction {allowedTargets=2;};
        class TYR_fnc_ServerRunAutomatedTests {allowedTargets=2;};
        class TYR_fnc_ServerReportVisualContact {allowedTargets=2;};

        class TYR_fnc_ClientReceiveSnapshot {allowedTargets=1;};
        class TYR_fnc_ClientReceiveDeployment {allowedTargets=1;};
        class TYR_fnc_ClientReceiveFaction {allowedTargets=1;};
        class TYR_fnc_ClientReceiveLocation {allowedTargets=1;};
        class TYR_fnc_ClientReceiveKnowledge {allowedTargets=1;};
        class TYR_fnc_ClientHint {allowedTargets=1;};
        class TYR_fnc_ClientCaptureStatus {allowedTargets=1;};
        class TYR_fnc_ClientEndMission {allowedTargets=1;};
