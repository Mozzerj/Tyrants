        class TYR_fnc_ClientAttachEmplacementActions {allowedTargets=1; jip=1;};
        class TYR_fnc_ClientDebugState {allowedTargets=1;};
        class TYR_fnc_ClientDebugTeleport {allowedTargets=1;};
        class TYR_fnc_ClientDebugMapData {allowedTargets=1;};
        class TYR_fnc_ClientDebugAITraceData {allowedTargets=1;};
        class TYR_fnc_ClientDebugCommandResult {allowedTargets=1;};
        class TYR_fnc_ClientShowTestReport {allowedTargets=1;};
    };
    class Commands
    {
        mode = 1;
        jip = 0;
    };
